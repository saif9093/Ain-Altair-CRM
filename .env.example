# ── Supabase (required) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects /api/cron/* (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=
WORKER_CONCURRENCY=4
APP_CONTACT_EMAIL=

# ── Lead sources (all optional; configure at least one discovery source) ──
GOOGLE_PLACES_API_KEY=
APIFY_TOKEN=
APIFY_GOOGLE_MAPS_ACTOR=compass~crawler-google-places
APIFY_INSTAGRAM_ACTOR=apify~instagram-profile-scraper
# OpenStreetMap works without a key
OVERPASS_API_URL=
NOMINATIM_URL=
NOMINATIM_EMAIL=

# ── Enrichment / audit ──────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=
PAGESPEED_API_KEY=
AUDIT_USER_AGENT=

# ── AI (Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Google Sheets (optional interop) ────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SHARE_WITH=
